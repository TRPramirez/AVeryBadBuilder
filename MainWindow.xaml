<Window x:Class="BadBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AVeryBadBuilder" Height="640" Width="820"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#F1F5F9">

    <Window.Resources>
        <Storyboard x:Key="SuccessAnimationStoryboard">
            <DoubleAnimation Storyboard.TargetName="AnimatedCircle"
                             Storyboard.TargetProperty="StrokeDashOffset"
                             From="300" To="0" Duration="0:0:0.7">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckmarkTransform"
                             Storyboard.TargetProperty="ScaleX"
                             From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckmarkTransform"
                             Storyboard.TargetProperty="ScaleY"
                             From="0" To="1" BeginTime="0:0:0.55" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CheckmarkPath"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" BeginTime="0:0:0.5" Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#1E293B" CornerRadius="12" 
                                BorderBrush="#334155" BorderThickness="1" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F172A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItemStyle}"/>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#F8FAFC"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="Black"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="Black"/>
            </Style.Resources>
        </Style>

        <Style x:Key="ModernProgressBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="4" Background="#1E293B"/>
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#34D399" Offset="0"/>
                                        <GradientStop Color="#06B6D4" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" BorderBrush="#1E293B" BorderThickness="1" Margin="12">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1120" Offset="0"/>
                <GradientStop Color="#111827" Offset="0.5"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="72"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="16,16,0,0" MouseDown="OnTitleBarMouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock Text="AVeryBadBuilder" FontSize="15" FontWeight="SemiBold" Foreground="#F1F5F9"/>
                        <TextBlock Text="  •  Xbox 360 BadUpdate USB Builder" FontSize="13" Foreground="#64748B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                        <Button Content="Credits" Width="80" Height="28" 
                                Background="Transparent" Foreground="#60A5FA" BorderThickness="0"
                                FontSize="12" Cursor="Hand" Click="OnCreditsClicked"/>
                        <Button Content="─" Width="36" Height="28" Background="Transparent" 
                                Foreground="#94A3B8" BorderThickness="0" Click="OnMinimizeClicked"/>
                        <Button Content="✕" Width="36" Height="28" Background="Transparent" 
                                Foreground="#94A3B8" BorderThickness="0" Click="OnCloseClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="40,20">

                <!-- STEP 1 -->
                <StackPanel x:Name="Step1_Agreement" VerticalAlignment="Center">
                    <TextBlock Text="License Agreement" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Please review the agreement before building your BadUpdate USB."
                               FontSize="14" Foreground="#94A3B8" Margin="0,0,0,20"/>
                    <Border Background="#0F172A" BorderBrush="#1E293B" BorderThickness="1" 
                            CornerRadius="12" Height="200" Padding="18" Margin="0,0,0,20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Foreground="#CBD5E1" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                                END USER LICENSE AGREEMENT<LineBreak/><LineBreak/>
                                AVeryBadBuilder creates a USB drive for the Xbox 360 BadUpdate exploit.<LineBreak/><LineBreak/>
                                • All data on the selected drive will be permanently erased when formatting.<LineBreak/>
                                • You are solely responsible for selecting the correct drive.<LineBreak/>
                                • This tool downloads third-party exploits, bootstraps and homebrew.<LineBreak/>
                                • Use only on consoles you own. The authors are not responsible for any damage or bans.<LineBreak/><LineBreak/>
                                By continuing you accept these terms and confirm you understand the risks.
                            </TextBlock>
                        </ScrollViewer>
                    </Border>
                    <CheckBox x:Name="TosCheckBox" 
                              Content="I accept the agreement and understand that the selected drive will be erased."
                              Foreground="#E2E8F0" FontSize="13"
                              Checked="OnTosCheckChanged" Unchecked="OnTosCheckChanged"/>
                </StackPanel>

                <!-- STEP 2 -->
                <StackPanel x:Name="Step2_Drive" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Select Target Drive" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose the USB drive that will be formatted and prepared. All data will be lost."
                               FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24"/>
                    <TextBlock Text="Available drives" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#94A3B8" Margin="0,0,0,8"/>
                    <ComboBox x:Name="DriveComboBox" Height="44" Style="{StaticResource ModernComboBoxStyle}"
                              DisplayMemberPath="Display" SelectedValuePath="Disk"
                              SelectionChanged="OnDriveSelectionChanged"/>
                    <TextBlock x:Name="DriveWarning" 
                               Text="⚠  All data on the selected drive will be permanently erased."
                               Foreground="#FBBF24" FontSize="13" Margin="0,14,0,0" Visibility="Collapsed"/>
                </StackPanel>

                <!-- STEP 3 -->
                <StackPanel x:Name="Step3_Exploit" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Choose Exploit" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Select which BadUpdate exploit variant to install on the USB."
                               FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24"/>
                    <ComboBox x:Name="ExploitComboBox" Height="44" Style="{StaticResource ModernComboBoxStyle}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"/>
                </StackPanel>

                <!-- STEP 4 -->
                <StackPanel x:Name="Step4_Bootstrap" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Post-Exploit Bootstrap" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="The payload that runs after a successful exploit to unlock homebrew."
                               FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24"/>
                    <ComboBox x:Name="BootstrapComboBox" Height="44" Style="{StaticResource ModernComboBoxStyle}"
                              DisplayMemberPath="Display" SelectedValuePath="Value"/>
                </StackPanel>

                <!-- STEP 5 -->
                <StackPanel x:Name="Step5_Options" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock Text="Additional Options" FontSize="28" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Text="Configure firmware update and included homebrew packages."
                               FontSize="14" Foreground="#94A3B8" Margin="0,0,0,24"/>

                    <CheckBox x:Name="FirmwareUpdateCheckBox"
                              Content="Install official Dashboard Update 2.0.17559.0 only (skips exploit)"
                              Foreground="#E2E8F0" FontSize="14" Margin="0,0,0,24"/>

                    <TextBlock Text="Homebrew packages" FontSize="15" FontWeight="SemiBold" 
                               Foreground="#94A3B8" Margin="0,0,0,12"/>

                    <CheckBox x:Name="HomebrewAuroraCheckBox"
                              Content="Aurora (dashboard replacement)"
                              Foreground="#E2E8F0" FontSize="14" IsChecked="True" Margin="0,0,0,10"/>

                    <CheckBox x:Name="HomebrewXeXMenuCheckBox"
                              Content="XeXMenu (file manager / launcher)"
                              Foreground="#E2E8F0" FontSize="14" IsChecked="True" Margin="0,0,0,10"/>

                    <CheckBox x:Name="HomebrewNandFlasherCheckBox"
                              Content="Simple 360 NAND Flasher"
                              Foreground="#E2E8F0" FontSize="14" IsChecked="True" Margin="0,0,0,10"/>

                    <CheckBox x:Name="HomebrewXM360CheckBox"
                              Content="XM360 (content manager / XBLA &amp; DLC unlocker)"
                              Foreground="#E2E8F0" FontSize="14" IsChecked="True" Margin="0,0,0,16"/>

                    <Border Background="#0F172A" CornerRadius="8" Padding="12,10" Margin="0,8,0,0">
                        <TextBlock FontSize="12.5" Foreground="#94A3B8" TextWrapping="Wrap">
                            <Run Text="Note: " FontWeight="SemiBold" Foreground="#64748B"/>
                            The Aurora build of XeUnshackle is always used for the bootstrap — the stock NXE variant has been removed.
                        </TextBlock>
                    </Border>
                </StackPanel>

                <!-- STEP 6: Progress -->
                <StackPanel x:Name="Step6_Progress" Visibility="Collapsed" 
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Grid Width="130" Height="130" Margin="0,0,0,24">
                        <Ellipse Width="110" Height="110" Fill="#10B981" Opacity="0.1">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="40" Color="#10B981" Opacity="0.5" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="AnimatedCircle" Width="96" Height="96"
                                 Stroke="#34D399" StrokeThickness="5"
                                 StrokeDashArray="300" StrokeDashOffset="300"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Path x:Name="CheckmarkPath" Data="M 32 58 L 48 74 L 82 38"
                              Stroke="#34D399" StrokeThickness="6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform x:Name="CheckmarkTransform" ScaleX="0" ScaleY="0"/>
                            </Path.RenderTransform>
                        </Path>
                    </Grid>
                    <TextBlock x:Name="StatusTitle" Text="Preparing..." 
                               FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="StatusSubtext" Text="Please wait" 
                               FontSize="14" Foreground="#94A3B8"
                               HorizontalAlignment="Center" Margin="0,6,0,20"/>
                    <ProgressBar x:Name="MainProgressBar" Width="460" 
                                 Style="{StaticResource ModernProgressBarStyle}"
                                 Minimum="0" Maximum="100"/>
                </StackPanel>
            </Grid>

            <!-- Bottom Bar -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="0,0,16,16" Padding="32,0">
                <DockPanel VerticalAlignment="Center" LastChildFill="False">
                    <Button x:Name="BackButton" Content="Back" DockPanel.Dock="Left" 
                            Width="110" Height="42" Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnBackClicked" Visibility="Collapsed"/>
                    <Button x:Name="CancelButton" Content="Cancel" DockPanel.Dock="Left" 
                            Width="110" Height="42" Style="{StaticResource SecondaryButtonStyle}"
                            Click="OnCloseClicked" Margin="12,0,0,0"/>
                    <Button x:Name="NextButton" Content="Next" DockPanel.Dock="Right" 
                            Width="150" Height="42" Style="{StaticResource PrimaryButtonStyle}"
                            IsEnabled="False" Click="OnNextClicked"/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>