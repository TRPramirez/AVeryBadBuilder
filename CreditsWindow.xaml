<Window x:Class="BadBuilder.CreditsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Credits &amp; Proof" Height="540" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="#F1F5F9">

    <Window.Resources>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#10B981" Offset="0"/>
                                    <GradientStop Color="#059669" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="14" BorderBrush="#1E293B" BorderThickness="1" Margin="10">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0B1120" Offset="0"/>
                <GradientStop Color="#0F172A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="64"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <Border Grid.Row="0" Background="#0F172A" CornerRadius="14,14,0,0" MouseDown="OnTitleBarMouseDown">
                <Grid>
                    <TextBlock Text="Credits &amp; Proof" FontSize="14" FontWeight="SemiBold"
                               Foreground="#94A3B8" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <Button Content="✕" HorizontalAlignment="Right" Width="40" Height="30"
                            Background="Transparent" Foreground="#94A3B8" BorderThickness="0"
                            Click="OnCloseClicked" Margin="0,0,8,0"/>
                </Grid>
            </Border>

            <!-- Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="24,12,24,0">
                <StackPanel>
                    <TextBlock Text="Project Developer" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#64748B" Margin="0,0,0,4"/>
                    <TextBlock Text="int4rstellar" FontSize="16" FontWeight="SemiBold" 
                               Foreground="#60A5FA" Margin="0,0,0,20"/>

                    <TextBlock Text="Credits" FontSize="13" FontWeight="SemiBold" 
                               Foreground="#64748B" Margin="0,0,0,12"/>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Grimdoomer: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/grimdoomer/Xbox360BadUpdate"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">BadUpdate</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Shutterbug2000: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/shutterbug2000/ABadAvatar"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">ABadAvatar</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Bibarub: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/bibarub/Xbox360BadUpdate"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">ABadAvatar 1.3</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="InvoxiPlayGames: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/FreeMyXe/FreeMyXe"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">FreeMyXe</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Byrom90: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/Byrom90/XeUnshackle"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">XeUnshackle</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Swizzy: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://github.com/Swizzy/XDK_Projects"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">Simple 360 NAND Flasher</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Team XeDev: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://digiex.net/threads/xexmenu-1-1-download-xex-menu-iso-live-and-xex-file-manager-for-xbox-360.11096/"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">XeXMenu</Hyperlink>
                    </TextBlock>

                    <TextBlock Margin="0,0,0,10" FontSize="13.5">
                        <Run Text="Phoenix: " Foreground="#E2E8F0"/>
                        <Hyperlink NavigateUri="https://phoenix.xboxunity.net/#/news"
                                   RequestNavigate="OnHyperlinkClick" Foreground="#60A5FA">Aurora Dashboard</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>

            <!-- Close -->
            <Border Grid.Row="2" Padding="24,0">
                <Button Content="Close" Width="120" Height="38" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButtonStyle}" Click="OnCloseClicked"/>
            </Border>
        </Grid>
    </Border>
</Window>